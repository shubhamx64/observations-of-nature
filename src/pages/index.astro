---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getArtworks, artworkUrl, artworkAlt } from '../lib/artwork';
import site from '../content/site.json';
import { sitePath } from '../lib/url';
const artworks = await getArtworks();
const featured = artworks.filter(art => art.data.featured);
const selected = featured.length ? featured : artworks.slice(0, 4);
const hero = selected[0];
const socialImage = hero ? await getImage({src: hero.data.image, width: Math.min(1200, hero.data.image.width), format: 'jpg', quality: 90}) : undefined;
---
<Layout image={socialImage?.src}>
  <section class="hero wrap" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.home.eyebrow}</p>
      <h1 id="home-title">{site.home.heading.split('\n').map((line, i) => <>{i > 0 && <br />}{i > 0 ? <em>{line}</em> : line}</>)}</h1>
      <p class="hero-intro">{site.home.intro}</p>
      <a href={sitePath('/gallery/')} class="text-link">Explore the paintings <span aria-hidden="true">↗</span></a>
      <span class="hero-footnote">An ongoing collection</span>
    </div>
    {hero && <figure class="hero-art">
      <a href={artworkUrl(hero)} aria-label={`View ${hero.data.title}`}>
        <ArtworkImage image={hero.data.image} crop={hero.data.crop} alt={artworkAlt(hero)} eager sizes="(min-width: 1100px) 440px, (min-width: 700px) 42vw, 80vw" />
      </a>
      <figcaption><span>{hero.data.title}</span><span>{hero.data.category}</span></figcaption>
    </figure>}
  </section>
  <section class="selected-section wrap" aria-labelledby="selected-title">
    <div class="section-heading"><div><p class="eyebrow">From the collection</p><h2 id="selected-title">Selected works</h2></div><a href={sitePath('/gallery/')} class="text-link">View all {artworks.length} works <span aria-hidden="true">↗</span></a></div>
    <div class="artwork-grid selected-grid">{selected.slice(1, 4).map((artwork, index) => <ArtworkCard artwork={artwork} index={index} />)}</div>
    {artworks.length === 0 && <p>The first paintings will be shared here soon.</p>}
  </section>
  <section class="home-note wrap">
    <p class="eyebrow">The art of paying attention</p>
    <h2>{site.home.note}</h2>
    <a class="text-link" href={sitePath('/about/')}>About the collection <span aria-hidden="true">↗</span></a>
  </section>
</Layout>

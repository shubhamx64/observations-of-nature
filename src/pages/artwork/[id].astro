---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArtworkImage from '../../components/ArtworkImage.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import { getArtworks, artworkUrl, artworkAlt } from '../../lib/artwork';
import site from '../../content/site.json';
import ArtworkFrame from '../../components/ArtworkFrame.astro';
import { sitePath } from '../../lib/url';

export async function getStaticPaths() {
  const artworks = await getArtworks();
  return artworks.map((artwork, index) => {
    // The three paintings that follow this one in gallery order, wrapping around at the end.
    const related = artworks.length > 1 ? [1, 2, 3].map(step => artworks[(index + step) % artworks.length]).filter(a => a.id !== artwork.id) : [];
    return { params: { id: artwork.id }, props: { artwork, previous: artworks[index - 1], next: artworks[index + 1], related: [...new Set(related)], total: artworks.length } };
  });
}
const { artwork, previous, next, related, total } = Astro.props;
const { data } = artwork;
const { Content } = await render(artwork);
const fullImage = await getImage({ src: data.image, width: data.image.width, format: 'jpg', quality: 95 });
const metadata = [['Year', data.year], ['Medium', data.medium], ['Dimensions', data.dimensions]].filter(([, value]) => value !== undefined && value !== '');
const inquiryUrl = site.contact.email ? `mailto:${site.contact.email}?subject=${encodeURIComponent(`Enquiry about ${data.title}`)}` : sitePath('/contact/');
const schema = Astro.site ? {
  '@context': 'https://schema.org', '@type': 'VisualArtwork', name: data.title,
  image: new URL(fullImage.src, Astro.site).href,
  url: new URL(artworkUrl(artwork), Astro.site).href,
  ...(data.description ? { description: data.description } : {}),
  ...(data.medium ? { artMedium: data.medium } : {}),
  ...(site.artistName ? { creator: { '@type': 'Person', name: site.artistName } } : {}),
} : undefined;
---
<Layout title={data.title} description={data.description || `${data.title}, a painting in the Observations of Nature collection.`} image={fullImage.src}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  <div class="wrap artwork-page">
    <a href={sitePath('/gallery/')} class="back-link"><span aria-hidden="true">←</span> Back to the gallery</a>
    <div class="artwork-detail">
      <figure class="detail-figure">
        <a class="enlarge-link" href={fullImage.src} data-open-viewer aria-label={`Enlarge ${data.title}`}>
          <ArtworkImage image={data.image} crop={data.crop} frameStyle={data.frameStyle} alt={artworkAlt(artwork)} eager large sizes="(min-width: 1100px) 760px, (min-width: 760px) 58vw, 92vw" />
        </a>
        <figcaption>Tap or click the painting to enlarge it</figcaption>
      </figure>
      <div class="detail-copy">
        <p class="eyebrow">{data.category}</p>
        <h1>{data.title}</h1>
        {data.provisionalTitle && <p class="working-title">Descriptive working title</p>}
        {data.description && <p class="detail-description">{data.description}</p>}
        <div class="prose"><Content /></div>
        {metadata.length > 0 && <dl class="artwork-metadata">{metadata.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
        {data.available !== undefined && <p class="availability">{data.available ? 'Available' : 'Sold'}{data.available && data.price ? ` — ${data.price}` : ''}</p>}
        <a class="text-link" href={inquiryUrl}>Ask about this painting <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {data.additionalImages.length > 0 && <section class="additional-images" aria-label="More views of this painting">{data.additionalImages.map((view, index) => <ArtworkImage image={view.image} frameStyle={data.frameStyle} alt={view.alt || `${data.title}, additional view ${index + 1}`} large />)}</section>}
    {related.length > 0 && <section class="related-section" aria-labelledby="related-title">
      <div class="section-heading"><div><p class="eyebrow">Keep looking</p><h2 id="related-title">More from the collection</h2></div><a href={sitePath('/gallery/')} class="text-link">View all {total} works <span aria-hidden="true">↗</span></a></div>
      <div class="artwork-grid trio-grid">{related.map(item => <ArtworkCard artwork={item} />)}</div>
    </section>}
    <nav class="artwork-pagination" aria-label="More paintings">
      <div>{previous && <a href={artworkUrl(previous)}><span>← Previous painting</span><strong>{previous.data.title}</strong></a>}</div>
      <div>{next && <a href={artworkUrl(next)}><span>Next painting →</span><strong>{next.data.title}</strong></a>}</div>
    </nav>
  </div>
  <dialog class="image-viewer" aria-label={`Larger view of ${data.title}`}>
    <div class="viewer-toolbar"><span>{data.title}</span><button type="button" data-close-viewer autofocus>Close <span aria-hidden="true">×</span></button></div>
    <div class="viewer-image-area"><ArtworkFrame image={data.image} crop={data.crop} frameStyle={data.frameStyle}>
      <img data-full-src={fullImage.src} alt={artworkAlt(artwork)} width={data.image.width} height={data.image.height} />
    </ArtworkFrame></div>
    <a href={fullImage.src} target="_blank" rel="noopener">Open full photograph <span class="sr-only">in a new tab</span> ↗</a>
  </dialog>
</Layout>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.image-viewer');
  const trigger = document.querySelector<HTMLAnchorElement>('[data-open-viewer]');
  const close = document.querySelector<HTMLButtonElement>('[data-close-viewer]');
  trigger?.addEventListener('click', event => {
    if (!viewer || typeof viewer.showModal !== 'function' || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const image = viewer.querySelector<HTMLImageElement>('img');
    if (image && !image.src) image.src = image.dataset.fullSrc || '';
    viewer.showModal();
    document.body.classList.add('viewer-open');
  });
  close?.addEventListener('click', () => viewer?.close());
  viewer?.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
  viewer?.addEventListener('close', () => { document.body.classList.remove('viewer-open'); trigger?.focus(); });
</script>
